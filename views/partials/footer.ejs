    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Client-side Interactive Script -->
    <script>
        // Chatbot terminal simulation
        const chatForm = document.getElementById('chatForm');
        const chatInput = document.getElementById('chatInput');
        const chatStream = document.getElementById('chatStream');
        const chatSubmitBtn = document.getElementById('chatSubmitBtn');

        if (chatForm) {
            chatForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const text = chatInput.value.trim();
                if (!text) return;

                // Append user bubble
                const userBubble = document.createElement('div');
                userBubble.className = 'chat-bubble-user';
                userBubble.textContent = text;
                chatStream.appendChild(userBubble);
                chatInput.value = '';
                chatStream.scrollTop = chatStream.scrollHeight;

                // Loading indicator
                const botBubble = document.createElement('div');
                botBubble.className = 'chat-bubble-bot text-muted';
                botBubble.innerHTML = '<i class="fas fa-circle-notch fa-spin me-1"></i> Thinking...';
                chatStream.appendChild(botBubble);
                chatStream.scrollTop = chatStream.scrollHeight;

                try {
                    const res = await fetch('/chatbot', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ phone: '917219125818', text: text })
                    });
                    const data = await res.json();
                    botBubble.className = 'chat-bubble-bot';
                    botBubble.innerHTML = (data.reply || 'No reply received.').replace(/\n/g, '<br>');
                } catch (err) {
                    botBubble.className = 'chat-bubble-bot text-danger';
                    botBubble.textContent = 'Error connecting to chatbot server.';
                }
                chatStream.scrollTop = chatStream.scrollHeight;
            });

            // Quick suggestions
            document.querySelectorAll('.suggestion-pill').forEach(btn => {
                btn.addEventListener('click', () => {
                    chatInput.value = btn.getAttribute('data-prompt') || '';
                    chatForm.dispatchEvent(new Event('submit'));
                });
            });
        }
    </script>
